<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE beans PUBLIC "-//SPRING//DTD BEAN 2.0//EN"
        "http://www.springframework.org/dtd/spring-beans-2.0.dtd">

<beans>

	<bean class="com.entity.Employee"></bean>

	<bean class="com.entity.Employee" id="emp1">
		<property name="id" value="1"></property>
		<property name="name" value="Monika"></property>
		<property name="age" value="23"></property>
		<property name="city" value="Latur"></property>
	</bean>

	<bean class="com.entity.Employee" id="emp2">
		<constructor-arg index="0" value="101"></constructor-arg>
		<constructor-arg index="1" value="Kiran"></constructor-arg>
		<constructor-arg index="2" value="21"></constructor-arg>
		<constructor-arg index="3" value="Jalna"></constructor-arg>

	</bean>

</beans>